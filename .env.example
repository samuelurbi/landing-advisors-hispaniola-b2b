# URL que recibe el registro de advisors y las solicitudes de cotización (POST JSON).
# Sin ella, la landing simula el envío y muestra el estado de éxito (modo preview).
VITE_FORM_ENDPOINT=

# --- SEO (los lee scripts/prerender.mjs en `npm run build`) ---
# Dominio final, sin barra al final. Se usa en canonical, og:url, og:image,
# twitter:image, JSON-LD, robots.txt, sitemap.xml y llms.txt.
# Por defecto: https://landing-advisors-hispaniola.vercel.app
SITIO=
# 1 = indexable (quita el noindex y abre robots.txt). Vacío = vista previa
# (noindex, nofollow + Disallow: /). Solo el día del lanzamiento.
INDEXAR=
